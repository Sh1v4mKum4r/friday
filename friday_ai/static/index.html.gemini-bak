</head>
<body class="dark bg-black">
<div id="app-root">
    <div style="display:flex; justify-content:center; align-items:center; height:100vh; color:#fff; background:#000;">
        Loading Neural Pathways...
    </div>
</div>
<script>
window.onerror = function(msg, url, line, col, error) {
    const el = document.createElement('div');
    el.innerHTML = `<div style="color:red; background:#111; z-index:9999; position:fixed; top:0; left:0; width:100%; height:100vh; overflow:auto; padding:20px; font-family:monospace; box-sizing:border-box;"><h1>JS Error</h1><p>${msg}</p><p>Line: ${line}, Col: ${col}</p><pre>${error && error.stack}</pre></div>`;
    document.body.appendChild(el);
};

try {
    window.THEMES = {"obsidian": {"tw": "\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"inverse-on-surface\": \"#55545d\",\n                    \"surface-container\": \"#11111a\",\n                    \"inverse-primary\": \"#6e3bd7\",\n                    \"tertiary-dim\": \"#d9d9e1\",\n                    \"surface-container-low\": \"#0d0d14\",\n                    \"outline\": \"#76747e\",\n                    \"on-primary-container\": \"#2b006e\",\n                    \"surface-variant\": \"#1a1a24\",\n                    \"on-background\": \"#f2effa\",\n                    \"on-error-container\": \"#ffb2b9\",\n                    \"surface\": \"#08080f\",\n                    \"on-tertiary-container\": \"#53555b\",\n                    \"on-secondary\": \"#2b0065\",\n                    \"on-secondary-fixed\": \"#440097\",\n                    \"secondary-dim\": \"#8b4ef7\",\n                    \"secondary-container\": \"#5d03ca\",\n                    \"on-error\": \"#490013\",\n                    \"on-surface-variant\": \"#acaab4\",\n                    \"primary-dim\": \"#8455ef\",\n                    \"primary\": \"#ba9eff\",\n                    \"error\": \"#ff6e84\",\n                    \"on-primary-fixed-variant\": \"#370086\",\n                    \"primary-fixed\": \"#ae8dff\",\n                    \"surface-bright\": \"#1a1a26\",\n                    \"on-secondary-fixed-variant\": \"#651ad1\",\n                    \"on-primary\": \"#39008c\",\n                    \"background\": \"#08080f\",\n                    \"on-surface\": \"#f2effa\",\n                    \"secondary\": \"#b088ff\",\n                    \"on-tertiary-fixed-variant\": \"#5d5f65\",\n                    \"surface-dim\": \"#08080f\",\n                    \"surface-tint\": \"#ba9eff\",\n                    \"secondary-fixed\": \"#dcc9ff\",\n                    \"on-tertiary\": \"#5c5d64\",\n                    \"secondary-fixed-dim\": \"#d0b8ff\",\n                    \"tertiary-fixed-dim\": \"#d9d9e1\",\n                    \"inverse-surface\": \"#fcf8ff\",\n                    \"tertiary-fixed\": \"#e7e7ef\",\n                    \"error-dim\": \"#d73357\",\n                    \"tertiary-container\": \"#e7e7ef\",\n                    \"on-tertiary-fixed\": \"#414349\",\n                    \"primary-container\": \"#ae8dff\",\n                    \"primary-fixed-dim\": \"#a27cff\",\n                    \"tertiary\": \"#f6f6fe\",\n                    \"outline-variant\": \"#2a2a35\",\n                    \"surface-container-high\": \"#161621\",\n                    \"on-primary-fixed\": \"#000000\",\n                    \"surface-container-lowest\": \"#05050a\",\n                    \"on-secondary-container\": \"#decbff\",\n                    \"surface-container-highest\": \"#1c1c28\",\n                    \"error-container\": \"#a70138\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.5rem\",\n                    \"lg\": \"0.75rem\",\n                    \"xl\": \"1rem\",\n                    \"2xl\": \"1.25rem\",\n                    \"3xl\": \"1.5rem\",\n                    \"full\": \"9999px\"\n            },\n            \"fontFamily\": {\n                    \"headline\": [\"Inter\"],\n                    \"body\": [\"Inter\"],\n                    \"label\": [\"Inter\"],\n                    \"mono\": [\"JetBrains Mono\"]\n            }\n          },\n        },\n      }\n    ", "css": "\n        body {\n            background-color: #08080f;\n            color: #f2effa;\n            scrollbar-width: thin;\n            scrollbar-color: #1a1a24 #08080f;\n        }\n        ::-webkit-scrollbar { width: 4px; }\n        ::-webkit-scrollbar-track { background: #08080f; }\n        ::-webkit-scrollbar-thumb { background: #1a1a24; border-radius: 10px; }\n        ::-webkit-scrollbar-thumb:hover { background: #ba9eff; }\n        \n        .glass {\n            background: rgba(255, 255, 255, 0.02);\n            backdrop-filter: blur(20px);\n            -webkit-backdrop-filter: blur(20px);\n        }\n        .user-glass {\n            background: rgba(186, 158, 255, 0.03);\n            backdrop-filter: blur(24px);\n            -webkit-backdrop-filter: blur(24px);\n            box-shadow: 0 0 20px rgba(186, 158, 255, 0.08);\n        }\n        .pulse-secondary {\n            box-shadow: 0 0 30px rgba(139, 92, 246, 0.2);\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;\n        }\n    ", "html": "<body class=\"flex h-screen overflow-hidden font-body selection:bg-primary/30\">\n<!-- SideNavBar -->\n<aside class=\"flex flex-col h-full py-8 bg-[#0a0a12]/80 backdrop-blur-xl w-[280px] sticky left-0 top-0 border-r border-outline-variant/10 transition-all z-[60]\">\n<!-- Header -->\n<div class=\"px-8 mb-10\">\n<div class=\"flex items-center gap-4\">\n<div class=\"w-9 h-9 rounded-2xl bg-gradient-to-tr from-primary to-primary-dim flex items-center justify-center pulse-secondary\">\n<span class=\"text-on-primary text-sm font-bold\">F<\/span>\n<\/div>\n<div>\n<h1 class=\"text-lg font-semibold tracking-tight text-[#ba9eff]\">Friday<\/h1>\n<p class=\"text-[9px] uppercase tracking-[0.2em] text-on-surface-variant/40 font-medium\">Curator Engine<\/p>\n<\/div>\n<\/div>\n<\/div>\n<!-- CTA -->\n<div class=\"px-6 mb-8\">\n<button class=\"w-full flex items-center justify-center gap-2 py-3.5 px-4 bg-white/5 hover:bg-white/10 text-[#ba9eff] border border-primary/20 rounded-2xl transition-all font-medium text-sm\">\n<span class=\"material-symbols-outlined text-lg\">add<\/span>\n                New Session\n            <\/button>\n<\/div>\n<!-- History -->\n<nav class=\"flex-1 overflow-y-auto px-4\">\n<p class=\"px-4 mb-4 text-[10px] uppercase tracking-[0.2em] text-on-surface-variant/30 font-semibold\">Curation History<\/p>\n<div class=\"space-y-1\">\n<!-- Active Item -->\n<a class=\"flex items-center gap-3 py-3 px-4 text-[#f2effa] bg-white/5 rounded-2xl border border-white/5 group\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px] opacity-40 group-hover:opacity-100\">bubble_chart<\/span>\n<span class=\"text-sm font-medium truncate\">Neural Synthesis Architecture<\/span>\n<\/a>\n<a class=\"flex items-center gap-3 py-3 px-4 text-[#f2effa]/40 hover:text-[#f2effa] hover:bg-white/5 transition-all rounded-2xl group\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px] opacity-20 group-hover:opacity-100\">data_object<\/span>\n<span class=\"text-sm font-medium truncate\">React Tailwind Refactoring<\/span>\n<\/a>\n<a class=\"flex items-center gap-3 py-3 px-4 text-[#f2effa]/40 hover:text-[#f2effa] hover:bg-white/5 transition-all rounded-2xl group\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px] opacity-20 group-hover:opacity-100\">analytics<\/span>\n<span class=\"text-sm font-medium truncate\">Market Analysis v4<\/span>\n<\/a>\n<\/div>\n<p class=\"px-4 mt-10 mb-4 text-[10px] uppercase tracking-[0.2em] text-on-surface-variant/30 font-semibold\">System<\/p>\n<div class=\"space-y-1\">\n<a class=\"flex items-center gap-3 py-3 px-4 text-[#f2effa]/40 hover:text-[#f2effa] hover:bg-white/5 transition-all rounded-2xl group\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px] opacity-20 group-hover:opacity-100\">monitoring<\/span>\n<span class=\"text-sm font-medium\">Analytics<\/span>\n<\/a>\n<a class=\"flex items-center gap-3 py-3 px-4 text-[#f2effa]/40 hover:text-[#f2effa] hover:bg-white/5 transition-all rounded-2xl group\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px] opacity-20 group-hover:opacity-100\">inventory_2<\/span>\n<span class=\"text-sm font-medium\">Archives<\/span>\n<\/a>\n<\/div>\n<\/nav>\n<!-- Footer -->\n<div class=\"mt-auto px-6 pt-6 border-t border-outline-variant/10\">\n<div class=\"flex items-center justify-between p-4 rounded-2xl bg-white/[0.02] border border-white/5\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary text-lg\">electric_bolt<\/span>\n<span class=\"text-xs font-medium opacity-60\">Status<\/span>\n<\/div>\n<div class=\"flex gap-1.5\">\n<div class=\"w-1.5 h-1.5 rounded-full bg-primary animate-pulse shadow-[0_0_8px_rgba(186,158,255,0.6)]\"><\/div>\n<div class=\"w-1.5 h-1.5 rounded-full bg-primary/20\"><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/aside>\n<!-- Main Content Canvas -->\n<main class=\"flex-1 flex flex-col relative bg-background overflow-hidden\">\n<!-- TopAppBar -->\n<header class=\"flex justify-end items-center px-12 h-20 w-full sticky top-0 z-50 bg-transparent backdrop-blur-xl border-b border-white/5\">\n<div class=\"flex items-center gap-8\">\n<button class=\"text-[#f2effa]/40 hover:text-[#ba9eff] transition-all\" onclick=\"toggleSettings()\">\n<span class=\"material-symbols-outlined text-[22px]\">tune<\/span>\n<\/button>\n<button class=\"text-[#f2effa]/40 hover:text-[#ba9eff] transition-all\" onclick=\"toggleSettings()\">\n<span class=\"material-symbols-outlined text-[22px]\">settings<\/span>\n<\/button>\n<div class=\"w-9 h-9 rounded-2xl overflow-hidden border border-white/10 ring-4 ring-white/5\">\n<img alt=\"User Profile\" class=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCRotIOgJypDKw2kloSWTVN2vhYSEYkWvFrkaNNwEAVYlHKn06l9pAyhGO1Ou8Dkxo0MHu6xDtmunLrrIA-K5hFUM-Uu99MXwxXCYj8thc6pXhyzoQBg0REK7tgXGaJYpZ3vCt1AI0LlN4ecKEeJUz3TY3wb3ofJdNSkMyG_sdJ_FXH5ocfszYaas_jQTkpIleh9a7td5yhbDSUI2v6BWSwfQ26F9GglnbNgPvVErirz-OafIjbGAZ0tW5u-PrlX4Ls4Ia5-pO5e0E\"/>\n<\/div>\n<\/div>\n<\/header>\n<!-- Message Stream -->\n<section class=\"flex-1 overflow-y-auto px-6 md:px-24 py-12 space-y-16\" id=\"chatArea\"><\/section>\n<!-- Input Area Wrapper -->\n<div class=\"p-8 md:px-24 md:pb-12 bg-gradient-to-t from-background via-background/95 to-transparent relative z-10\">\n<!-- BottomNavBar -->\n<div class=\"mb-6 flex justify-center\">\n<div class=\"rounded-3xl bg-black/40 backdrop-blur-3xl border border-white/10 flex p-1.5 shadow-[0_32px_64px_rgba(0,0,0,0.6)]\">\n<button class=\"bg-gradient-to-br from-[#ba9eff] to-[#8455ef] text-white rounded-2xl px-8 py-2.5 shadow-[0_0_25px_rgba(139,92,246,0.2)] flex items-center gap-2.5 transition-transform hover:scale-[1.02] active:scale-[0.98]\">\n<span class=\"material-symbols-outlined text-[18px]\">chat_bubble<\/span>\n<span class=\"font-mono text-[11px] font-bold uppercase tracking-[0.15em]\">Chat<\/span>\n<\/button>\n<button class=\"text-[#f2effa]/40 px-8 py-2.5 hover:text-[#f2effa] transition-all flex items-center gap-2.5 group\">\n<span class=\"material-symbols-outlined text-[18px] opacity-40 group-hover:opacity-100\">terminal<\/span>\n<span class=\"font-mono text-[11px] font-bold uppercase tracking-[0.15em]\">Command<\/span>\n<\/button>\n<button class=\"text-[#f2effa]/40 px-8 py-2.5 hover:text-[#f2effa] transition-all flex items-center gap-2.5 group\">\n<span class=\"material-symbols-outlined text-[18px] opacity-40 group-hover:opacity-100\">search<\/span>\n<span class=\"font-mono text-[11px] font-bold uppercase tracking-[0.15em]\">Search<\/span>\n<\/button>\n<\/div>\n<\/div>\n<!-- Input Bar -->\n<div class=\"max-w-4xl mx-auto relative group\">\n<div class=\"absolute -inset-1 bg-gradient-to-r from-primary/10 to-primary-dim/10 rounded-[32px] blur-xl opacity-20 group-focus-within:opacity-100 transition-opacity\"><\/div>\n<div class=\"relative flex items-center bg-white/[0.03] backdrop-blur-3xl border border-white/10 rounded-[28px] p-2.5 pl-8 shadow-2xl transition-all focus-within:border-primary/30\">\n<button class=\"text-on-surface-variant/40 hover:text-primary transition-colors pr-5 group/btn\">\n<span class=\"material-symbols-outlined text-[22px]\">attach_file<\/span>\n<\/button>\n<input class=\"w-full bg-transparent border-none focus:ring-0 text-on-surface placeholder:text-on-surface-variant/20 py-4 text-sm font-light tracking-wide\" id=\"input\" placeholder=\"Curate a message or command...\" type=\"text\"/>\n<div class=\"flex items-center gap-3 pr-3\">\n<button class=\"p-3 rounded-2xl text-on-surface-variant/40 hover:bg-white/5 transition-all\">\n<span class=\"material-symbols-outlined text-[20px]\">mic<\/span>\n<\/button>\n<button class=\"p-3.5 rounded-2xl bg-primary text-on-primary shadow-lg hover:scale-105 active:scale-95 transition-all flex items-center justify-center\" id=\"sendBtn\">\n<span class=\"material-symbols-outlined text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">send<\/span>\n<\/button>\n<\/div>\n<\/div>\n<\/div>\n<!-- Subtle Metadata -->\n<div class=\"mt-6 text-center\">\n<p class=\"text-[10px] text-on-surface-variant/20 font-mono tracking-[0.3em] uppercase\">Powered by Friday Obsidian \u2022 Neural Engine v9.0.2<\/p>\n<\/div>\n<\/div>\n<\/main>\n<!-- Visual Accents (Glows) -->\n<div class=\"fixed top-[-15%] right-[-10%] w-[600px] h-[600px] bg-primary/5 rounded-full blur-[150px] pointer-events-none z-0\"><\/div>\n<div class=\"fixed bottom-[-15%] left-[-5%] w-[700px] h-[700px] bg-primary-dim/5 rounded-full blur-[180px] pointer-events-none z-0\"><\/div>\n<div class=\"fixed top-[40%] left-[20%] w-[400px] h-[400px] bg-secondary/3 rounded-full blur-[120px] pointer-events-none z-0\"><\/div>\n<div class=\"fixed inset-0 z-[100] flex justify-end\" id=\"settingsOverlay\">\n<!-- Dark semi-transparent overlay -->\n<div class=\"absolute inset-0 bg-black/60 backdrop-blur-sm\"><\/div>\n<!-- Slide-out Panel -->\n<div class=\"relative w-full max-w-[440px] glass-surface h-full flex flex-col shadow-[0_0_100px_rgba(0,0,0,0.8)] border-l border-outline-variant/10\" id=\"settingsPanel\">\n<!-- Panel Header -->\n<div class=\"p-8 flex items-center justify-between\">\n<div>\n<h2 class=\"text-2xl font-bold tracking-tight text-on-surface\">Settings<\/h2>\n<p class=\"text-on-surface-variant text-sm mt-1\">Configure your AI workspace<\/p>\n<\/div>\n<button class=\"w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/5 transition-colors\" onclick=\"toggleSettings()\">\n<span class=\"material-symbols-outlined\">close<\/span>\n<\/button>\n<\/div>\n<!-- Scrollable Settings -->\n<div class=\"flex-1 overflow-y-auto px-8 py-4 space-y-10 scrollbar-hide\">\n<!-- General Section -->\n<section class=\"space-y-6\">\n<h3 class=\"text-xs font-mono uppercase tracking-[0.2em] text-primary/80\">General<\/h3>\n<div class=\"space-y-4\">\n<!-- Dark Mode Toggle -->\n<div class=\"flex items-center justify-between group\">\n<div class=\"space-y-0.5\">\n<p class=\"text-on-surface font-medium\">Dark Mode<\/p>\n<p class=\"text-on-surface-variant text-xs\">Optimized for low-light environments<\/p>\n<\/div>\n<div class=\"w-11 h-6 bg-primary-dim rounded-full flex items-center px-1\">\n<div class=\"w-4 h-4 bg-white rounded-full translate-x-5 shadow-sm\"><\/div>\n<\/div>\n<\/div>\n<!-- Streaming Toggle -->\n<div class=\"flex items-center justify-between group\">\n<div class=\"space-y-0.5\">\n<p class=\"text-on-surface font-medium\">Streaming<\/p>\n<p class=\"text-on-surface-variant text-xs\">Display tokens as they are generated<\/p>\n<\/div>\n<div class=\"w-11 h-6 bg-primary-dim rounded-full flex items-center px-1\">\n<div class=\"w-4 h-4 bg-white rounded-full translate-x-5 shadow-sm\"><\/div>\n<\/div>\n<\/div>\n<!-- History Toggle -->\n<div class=\"flex items-center justify-between group\">\n<div class=\"space-y-0.5\">\n<p class=\"text-on-surface font-medium\">History<\/p>\n<p class=\"text-on-surface-variant text-xs\">Sync conversations across devices<\/p>\n<\/div>\n<div class=\"w-11 h-6 bg-outline-variant/30 rounded-full flex items-center px-1\">\n<div class=\"w-4 h-4 bg-white/60 rounded-full shadow-sm\"><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/section>\n<section class=\"space-y-4\">\n<h3 class=\"text-xs font-mono uppercase tracking-[0.2em] text-primary/80\">MCP Servers &amp; Tools<\/h3>\n<div class=\"space-y-2\" id=\"settingsMCP\"><\/div>\n<div class=\"flex flex-wrap gap-2\" id=\"settingsTools\"><\/div>\n<\/section>\n<section class=\"space-y-4\">\n<div class=\"flex justify-between items-center\">\n<h3 class=\"text-xs font-mono uppercase tracking-[0.2em] text-primary/80\">Memory Context<\/h3>\n<button class=\"text-xs text-error hover:underline\" onclick=\"clearMemory()\">Clear All<\/button>\n<\/div>\n<div class=\"space-y-2\" id=\"settingsMemory\"><\/div>\n<\/section>\n<!-- Provider Section -->\n<section class=\"space-y-6\">\n<h3 class=\"text-xs font-mono uppercase tracking-[0.2em] text-primary/80\">Provider<\/h3>\n<div class=\"space-y-4\">\n<div class=\"space-y-2\">\n<label class=\"text-sm text-on-surface-variant font-medium\">Model Provider<\/label>\n<div class=\"relative group\">\n<div class=\"w-full h-12 bg-surface-container-low ghost-border rounded-xl px-4 flex items-center justify-between cursor-pointer hover:bg-surface-container transition-colors\">\n<span class=\"text-on-surface\">Claude 3.5 Sonnet<\/span>\n<span class=\"material-symbols-outlined text-on-surface-variant\">expand_more<\/span>\n<\/div>\n<!-- Dropdown Mock (Hidden by default, represented visually) -->\n<div class=\"absolute top-14 left-0 w-full glass-surface ghost-border rounded-xl p-2 hidden\">\n<div class=\"p-3 hover:bg-white/5 rounded-lg text-sm\">GPT-4 Turbo<\/div>\n<div class=\"p-3 hover:bg-white/5 rounded-lg text-sm\">Llama 3 (70B)<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/section>\n<!-- Appearance Section -->\n<section class=\"space-y-6\">\n<h3 class=\"text-xs font-mono uppercase tracking-[0.2em] text-primary/80\">Theme Switcher<\/h3>\n<div class=\"grid grid-cols-2 gap-3\">\n<!-- Obsidian Theme -->\n<button class=\"flex flex-col gap-2 group text-left\" onclick=\"applyTheme('obsidian')\">\n<div class=\"aspect-video w-full rounded-xl ghost-border bg-gradient-to-br from-primary/20 to-transparent flex flex-col justify-end p-2 border-2 border-primary transition-all group-hover:shadow-[0_0_15px_rgba(186,158,255,0.2)]\">\n<div class=\"w-full h-1.5 bg-primary/40 rounded-full\"><\/div>\n<div class=\"w-2/3 h-1.5 bg-primary/20 rounded-full mt-1\"><\/div>\n<\/div>\n<span class=\"text-[10px] font-mono uppercase tracking-wider text-on-surface text-center\">Obsidian<\/span>\n<\/button>\n<!-- Techno Theme -->\n<button class=\"flex flex-col gap-2 group text-left\" onclick=\"applyTheme('techno')\">\n<div class=\"aspect-video w-full rounded-xl ghost-border bg-[#0a0a0f] flex flex-col justify-end p-2 transition-all hover:bg-surface-variant hover:border-primary/40\">\n<div class=\"w-full h-1.5 bg-[#00ff41]/20 rounded-full\"><\/div>\n<div class=\"w-2/3 h-1.5 bg-[#00ff41]/10 rounded-full mt-1\"><\/div>\n<\/div>\n<span class=\"text-[10px] font-mono uppercase tracking-wider text-on-surface-variant text-center\">Techno<\/span>\n<\/button>\n<!-- Neural Theme -->\n<button class=\"flex flex-col gap-2 group text-left\" onclick=\"applyTheme('neural')\">\n<div class=\"aspect-video w-full rounded-xl ghost-border bg-gradient-to-br from-[#80d0ff]/10 to-[#e0c3fc]/10 flex flex-col justify-end p-2 transition-all hover:bg-white/5 hover:border-white/20\">\n<div class=\"w-full h-1.5 bg-white/20 rounded-full\"><\/div>\n<div class=\"w-2/3 h-1.5 bg-white/10 rounded-full mt-1\"><\/div>\n<\/div>\n<span class=\"text-[10px] font-mono uppercase tracking-wider text-on-surface-variant text-center\">Neural<\/span>\n<\/button>\n<!-- Prism Theme -->\n<button class=\"flex flex-col gap-2 group text-left\" onclick=\"applyTheme('prism')\">\n<div class=\"aspect-video w-full rounded-xl ghost-border bg-black relative overflow-hidden flex flex-col justify-end p-2 transition-all hover:bg-white/5 hover:border-error/40\">\n<div class=\"absolute inset-0 bg-gradient-to-tr from-transparent via-error/40 to-transparent rotate-12 scale-150\"><\/div>\n<div class=\"w-full h-1.5 bg-error/40 rounded-full relative z-10\"><\/div>\n<div class=\"w-2/3 h-1.5 bg-error/20 rounded-full mt-1 relative z-10\"><\/div>\n<\/div>\n<span class=\"text-[10px] font-mono uppercase tracking-wider text-on-surface-variant text-center\">Prism<\/span>\n<\/button>\n<\/div>\n<\/section>\n<\/div>\n<!-- Footer Actions -->\n<div class=\"p-8 mt-auto space-y-6\">\n<div class=\"flex items-center gap-4 p-4 rounded-2xl bg-surface-container-low ghost-border\">\n<div class=\"relative w-2 h-2\">\n<div class=\"absolute inset-0 bg-secondary rounded-full animate-pulse blur-[4px]\"><\/div>\n<div class=\"relative w-2 h-2 bg-secondary rounded-full\"><\/div>\n<\/div>\n<span class=\"text-xs font-mono text-on-surface-variant uppercase tracking-wider\">Sync Status: All changes up to date<\/span>\n<\/div>\n<button class=\"w-full bg-gradient-to-r from-primary to-primary-dim text-on-primary-container font-bold py-4 rounded-xl shadow-[0_0_20px_rgba(139,92,246,0.3)] transition-transform active:scale-[0.98]\">\n            Save Changes\n          <\/button>\n<\/div>\n<\/div>\n<\/div><\/body>", "user_bubble": "<div class=\"flex flex-col items-end space-y-3\">\n<div class=\"max-w-[85%] md:max-w-[65%] p-7 rounded-[28px] rounded-tr-[4px] user-glass border border-primary/20 text-on-surface\">\n<p class=\"text-[15px] leading-relaxed font-light tracking-wide\">{TEXT}<\/p>\n<\/div>\n<div class=\"flex items-center gap-2 px-2 text-[10px] text-on-surface-variant/30 font-mono tracking-widest\">\n<span>10:42 AM<\/span>\n<span class=\"material-symbols-outlined text-[14px]\">done_all<\/span>\n<\/div>\n<\/div>", "friday_bubble": "<div class=\"flex gap-6 items-start max-w-[95%] md:max-w-[85%] group\">\n<div class=\"w-12 h-12 rounded-3xl bg-surface-container flex-shrink-0 flex items-center justify-center border border-white/10 relative transition-transform group-hover:scale-105\">\n<span class=\"text-primary font-bold text-xl\">F<\/span>\n<div class=\"absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-primary rounded-full border-[3px] border-background shadow-[0_0_10px_rgba(186,158,255,0.4)]\"><\/div>\n<\/div>\n<div class=\"space-y-5 flex-1\">\n<div class=\"glass p-8 rounded-[32px] rounded-tl-[4px] border border-white/10\">\n\n\n<!-- Code Block -->\n\n<div class=\"chat-markdown-content overflow-x-hidden\">{TEXT}<\/div><\/div>\n<div class=\"flex items-center gap-6 px-4\">\n<span class=\"text-[10px] text-on-surface-variant/30 font-mono tracking-widest uppercase\">Obsidian Analysis \u2022 10:43 AM<\/span>\n<div class=\"flex gap-4\">\n<button class=\"material-symbols-outlined text-[18px] text-on-surface-variant/30 hover:text-primary transition-colors\">thumb_up<\/button>\n<button class=\"material-symbols-outlined text-[18px] text-on-surface-variant/30 hover:text-primary transition-colors\">refresh<\/button>\n<\/div>\n<\/div>\n<\/div>\n<\/div>"}, "techno": {"tw": "\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"on-secondary-container\": \"#004119\",\n                        \"on-surface-variant\": \"#cfc2d6\",\n                        \"on-background\": \"#e4e1ea\",\n                        \"on-primary-fixed-variant\": \"#6900b3\",\n                        \"on-primary-container\": \"#400071\",\n                        \"secondary\": \"#4ae176\",\n                        \"on-secondary-fixed\": \"#002109\",\n                        \"inverse-primary\": \"#842bd2\",\n                        \"surface-container\": \"#15151b\",\n                        \"surface-container-low\": \"#111116\",\n                        \"on-tertiary\": \"#003919\",\n                        \"on-primary-fixed\": \"#2c0051\",\n                        \"on-secondary\": \"#003915\",\n                        \"surface-dim\": \"#0a0a0d\",\n                        \"surface-bright\": \"#22222a\",\n                        \"surface\": \"#0a0a0d\",\n                        \"primary\": \"#ddb7ff\",\n                        \"on-primary\": \"#490080\",\n                        \"primary-fixed\": \"#f0dbff\",\n                        \"on-error-container\": \"#ffdad6\",\n                        \"surface-container-highest\": \"#2a2a32\",\n                        \"primary-container\": \"#b76dff\",\n                        \"on-error\": \"#690005\",\n                        \"secondary-fixed-dim\": \"#4ae176\",\n                        \"tertiary-fixed-dim\": \"#4de082\",\n                        \"on-tertiary-container\": \"#003115\",\n                        \"tertiary-container\": \"#00a755\",\n                        \"surface-container-lowest\": \"#050507\",\n                        \"outline\": \"#4d4354\",\n                        \"error-container\": \"#93000a\",\n                        \"on-tertiary-fixed\": \"#00210c\",\n                        \"tertiary-fixed\": \"#6dfe9c\",\n                        \"secondary-container\": \"#00b954\",\n                        \"background\": \"#020205\",\n                        \"inverse-surface\": \"#e4e1ea\",\n                        \"on-surface\": \"#e4e1ea\",\n                        \"primary-fixed-dim\": \"#ddb7ff\",\n                        \"outline-variant\": \"#333333\",\n                        \"surface-variant\": \"#1c1c21\",\n                        \"surface-tint\": \"#ddb7ff\",\n                        \"surface-container-high\": \"#1a1a20\",\n                        \"on-secondary-fixed-variant\": \"#005321\",\n                        \"tertiary\": \"#4de082\",\n                        \"on-tertiary-fixed-variant\": \"#005227\",\n                        \"error\": \"#ffb4ab\",\n                        \"secondary-fixed\": \"#6bff8f\",\n                        \"inverse-on-surface\": \"#1c1c21\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0px\",\n                        \"lg\": \"0px\",\n                        \"xl\": \"0px\",\n                        \"full\": \"0px\"\n                    },\n                    \"fontFamily\": {\n                        \"headline\": [\"JetBrains Mono\"],\n                        \"body\": [\"JetBrains Mono\"],\n                        \"label\": [\"JetBrains Mono\"]\n                    }\n                },\n            },\n        }\n    ", "css": "\n        body {\n            background-color: #020205;\n            background-image: \n                linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%),\n                linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));\n            background-size: 100% 4px, 3px 100%;\n            pointer-events: auto;\n        }\n        body::before {\n            content: \" \";\n            display: block;\n            position: fixed;\n            top: 0;\n            left: 0;\n            bottom: 0;\n            right: 0;\n            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.01), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.01));\n            z-index: 100;\n            background-size: 100% 2px, 3px 100%;\n            pointer-events: none;\n        }\n        .scanline {\n            width: 100%;\n            height: 100px;\n            z-index: 101;\n            background: linear-gradient(0deg, rgba(0, 0, 0, 0) 0%, rgba(74, 225, 118, 0.05) 50%, rgba(0, 0, 0, 0) 100%);\n            opacity: 0.1;\n            position: fixed;\n            bottom: 100%;\n            animation: scanline 10s linear infinite;\n        }\n        @keyframes scanline {\n            0% { bottom: 100%; }\n            100% { bottom: -100px; }\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;\n        }\n        .terminal-border {\n            border: 0.5px solid #4ae17640;\n        }\n        .terminal-header {\n            background: #4ae17615;\n            border-bottom: 0.5px solid #4ae17640;\n        }\n    ", "html": "<body class=\"text-on-background font-body min-h-screen flex flex-col selection:bg-secondary/30\">\n<div class=\"scanline\"><\/div>\n<!-- TopAppBar -->\n<header class=\"fixed top-0 right-0 left-0 z-40 flex justify-between items-center px-4 bg-background border-b-[0.5px] border-secondary/20 h-10\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-secondary text-sm\">terminal<\/span>\n<span class=\"text-xs font-bold text-secondary tracking-[0.2em]\">FRIDAY_OS [V.4.4.2]<\/span>\n<\/div>\n<div class=\"hidden sm:flex font-label text-[9px] tracking-widest uppercase text-secondary/60\">\n        SYS_LOAD: <span class=\"text-secondary ml-1\">0.12ms<\/span> | MEM_FREE: <span class=\"text-secondary ml-1\">94%<\/span>\n<\/div>\n<div class=\"flex items-center gap-4\">\n<div class=\"flex gap-4 font-label text-[9px] tracking-widest uppercase text-white/40\">\n<span class=\"hidden md:inline\">U_TIME: 442H<\/span>\n<span class=\"text-secondary\"><span class=\"animate-pulse\">\u25cf<\/span> LIVE<\/span>\n<\/div>\n<div class=\"flex gap-2\">\n<span class=\"material-symbols-outlined text-white/30 text-sm hover:text-secondary cursor-pointer transition-colors\">settings_input_component<\/span>\n<span class=\"material-symbols-outlined text-white/30 text-sm hover:text-secondary cursor-pointer transition-colors\">grid_view<\/span>\n<\/div>\n<\/div>\n<\/header>\n<!-- Main Content Area -->\n<main class=\"flex-1 mt-10 mb-16 overflow-y-auto px-4 py-8 md:px-24 lg:px-48 xl:px-64 scroll-smooth\">\n<div class=\"space-y-12\" id=\"chatArea\"><\/div>\n<\/main>\n<!-- Bottom Input Bar -->\n<footer class=\"fixed bottom-0 right-0 left-0 w-full z-50 bg-background border-t-[0.5px] border-secondary/20 h-16 flex items-center px-4\">\n<div class=\"flex-1 flex items-center terminal-border bg-surface-container-lowest relative group\">\n<button class=\"px-3 text-white/30 hover:text-secondary transition-colors\">\n<span class=\"material-symbols-outlined text-sm\">attach_file<\/span>\n<\/button>\n<input class=\"flex-1 bg-transparent border-none focus:ring-0 text-xs font-label text-on-surface placeholder:text-secondary/20 py-2\" id=\"input\" placeholder=\"&gt; EXECUTE_COMMAND_OR_QUERY...\" type=\"text\"/>\n<div class=\"flex items-center gap-2 pr-3\">\n<button class=\"w-8 h-8 flex items-center justify-center text-white/30 hover:text-secondary\">\n<span class=\"material-symbols-outlined text-sm\">mic<\/span>\n<\/button>\n<button class=\"bg-secondary/10 hover:bg-secondary/20 text-secondary terminal-border px-4 py-1 text-[9px] tracking-widest uppercase transition-all\" id=\"sendBtn\">\n                SEND_\n            <\/button>\n<\/div>\n<\/div>\n<div class=\"hidden lg:flex items-center gap-6 ml-6 border-l border-secondary/10 pl-6 h-10\">\n<div class=\"flex flex-col\">\n<span class=\"text-[8px] text-white/30 uppercase tracking-tighter\">LATENCY<\/span>\n<span class=\"text-[10px] text-secondary\">0.002MS<\/span>\n<\/div>\n<div class=\"flex flex-col\">\n<span class=\"text-[8px] text-white/30 uppercase tracking-tighter\">RESOURCES<\/span>\n<span class=\"text-[10px] text-primary\">1.2K_TOK<\/span>\n<\/div>\n<\/div>\n<\/footer>\n<!-- BottomNavBar (Mobile only) -->\n<nav class=\"md:hidden fixed bottom-0 right-0 left-0 w-full z-[60] flex justify-around items-center bg-background border-t-[0.5px] border-secondary/20 h-16\">\n<button class=\"flex flex-col items-center justify-center text-secondary border-t border-secondary pt-1\">\n<span class=\"material-symbols-outlined text-sm\" style=\"font-variation-settings: 'FILL' 1;\">terminal<\/span>\n<span class=\"text-[8px] mt-1 uppercase font-bold\">Terminal<\/span>\n<\/button>\n<button class=\"flex flex-col items-center justify-center text-white/30\">\n<span class=\"material-symbols-outlined text-sm\">memory<\/span>\n<span class=\"text-[8px] mt-1 uppercase font-bold\">Nodes<\/span>\n<\/button>\n<button class=\"flex flex-col items-center justify-center text-white/30\">\n<span class=\"material-symbols-outlined text-sm\">database<\/span>\n<span class=\"text-[8px] mt-1 uppercase font-bold\">Cache<\/span>\n<\/button>\n<\/nav>\n<div class=\"fixed inset-0 z-[100] flex justify-end\" id=\"settingsOverlay\">\n<!-- Dark semi-transparent overlay -->\n<div class=\"absolute inset-0 bg-black/60 backdrop-blur-sm\"><\/div>\n<!-- Slide-out Panel -->\n<div class=\"relative w-full max-w-[440px] glass-surface h-full flex flex-col shadow-[0_0_100px_rgba(0,0,0,0.8)] border-l border-outline-variant/10\" id=\"settingsPanel\">\n<!-- Panel Header -->\n<div class=\"p-8 flex items-center justify-between\">\n<div>\n<h2 class=\"text-2xl font-bold tracking-tight text-on-surface\">Settings<\/h2>\n<p class=\"text-on-surface-variant text-sm mt-1\">Configure your AI workspace<\/p>\n<\/div>\n<button class=\"w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/5 transition-colors\" onclick=\"toggleSettings()\">\n<span class=\"material-symbols-outlined\">close<\/span>\n<\/button>\n<\/div>\n<!-- Scrollable Settings -->\n<div class=\"flex-1 overflow-y-auto px-8 py-4 space-y-10 scrollbar-hide\">\n<!-- General Section -->\n<section class=\"space-y-6\">\n<h3 class=\"text-xs font-mono uppercase tracking-[0.2em] text-primary/80\">General<\/h3>\n<div class=\"space-y-4\">\n<!-- Dark Mode Toggle -->\n<div class=\"flex items-center justify-between group\">\n<div class=\"space-y-0.5\">\n<p class=\"text-on-surface font-medium\">Dark Mode<\/p>\n<p class=\"text-on-surface-variant text-xs\">Optimized for low-light environments<\/p>\n<\/div>\n<div class=\"w-11 h-6 bg-primary-dim rounded-full flex items-center px-1\">\n<div class=\"w-4 h-4 bg-white rounded-full translate-x-5 shadow-sm\"><\/div>\n<\/div>\n<\/div>\n<!-- Streaming Toggle -->\n<div class=\"flex items-center justify-between group\">\n<div class=\"space-y-0.5\">\n<p class=\"text-on-surface font-medium\">Streaming<\/p>\n<p class=\"text-on-surface-variant text-xs\">Display tokens as they are generated<\/p>\n<\/div>\n<div class=\"w-11 h-6 bg-primary-dim rounded-full flex items-center px-1\">\n<div class=