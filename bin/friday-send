#!/bin/bash
# friday-send — Send a prompt to the Friday daemon via Unix socket
# Usage: friday-send "your prompt"
#        echo "your prompt" | friday-send

SOCKET="${XDG_RUNTIME_DIR:-/tmp}/friday.sock"

if [ ! -S "$SOCKET" ]; then
    echo "Error: Friday daemon not running (no socket at $SOCKET)"
    exit 1
fi

# Get prompt from args or stdin
if [ $# -gt 0 ]; then
    PROMPT="$*"
else
    read -r PROMPT
fi

if [ -z "$PROMPT" ]; then
    echo "Usage: friday-send <prompt>"
    exit 1
fi

# Send to socket and read response using Python for reliable timeout handling
python3 -c "
import socket, os, sys
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect('$SOCKET')
sock.sendall(sys.argv[1].encode() + b'\n')
sock.settimeout(120)
data = b''
while True:
    try:
        chunk = sock.recv(4096)
        if not chunk:
            break
        data += chunk
    except socket.timeout:
        break
sock.close()
print(data.decode().strip())
" "$PROMPT"
