#!/bin/bash
# friday-send — Send a one-shot stateless prompt to Friday
# Usage: friday-send "your prompt"
#        echo "your prompt" | friday-send
# Always runs as a fresh session — no history, no context pollution.

PORT=65535
API="http://127.0.0.1:$PORT"

# Check if backend is running
if ! curl -s "$API/health" > /dev/null 2>&1; then
    echo "Error: Friday backend not running. Start with: friday start --daemon"
    exit 1
fi

# Get prompt from args or stdin
if [ $# -gt 0 ]; then
    PROMPT="$*"
else
    read -r PROMPT
fi

if [ -z "$PROMPT" ]; then
    echo "Usage: friday-send <prompt>"
    exit 1
fi

# Send stateless request directly to HTTP API
curl -s -X POST "$API/chat" \
    -H "Content-Type: application/json" \
    -d "$(python3 -c "import json,sys; print(json.dumps({'message': sys.argv[1], 'stateless': True}))" "$PROMPT")" \
    | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['response'])"
