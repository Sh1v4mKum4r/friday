#!/bin/bash
# friday-send — Send a one-shot stateless prompt to Friday
# Usage: friday-send "your prompt"
#        echo "your prompt" | friday-send

PORT=65535
API="http://127.0.0.1:$PORT"

# Check if backend is running
if ! curl -s "$API/health" > /dev/null 2>&1; then
    echo "Error: Friday backend not running. Start with: friday start --daemon"
    exit 1
fi

# Get prompt from args or stdin
if [ $# -gt 0 ]; then
    PROMPT="$*"
else
    read -r PROMPT
fi

if [ -z "$PROMPT" ]; then
    echo "Usage: friday-send <prompt>"
    exit 1
fi

# Send stateless request, extract response robustly
python3 -c "
import json, sys, urllib.request

prompt = sys.argv[1]
data = json.dumps({'message': prompt, 'stateless': True}).encode()
req = urllib.request.Request(
    '$API/chat',
    data=data,
    headers={'Content-Type': 'application/json'},
)
try:
    with urllib.request.urlopen(req, timeout=120) as resp:
        result = json.loads(resp.read())
        response = result.get('response', '')
        if response:
            print(response)
        else:
            print('(no response)')
except Exception as e:
    print(f'Error: {e}')
" "$PROMPT"
