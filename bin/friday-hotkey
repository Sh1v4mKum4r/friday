#!/bin/bash
# friday-hotkey — Open the Friday chat UI
# Triggered by Super+F keybind

PORT=65535

# Check if backend is running
if ! curl -s "http://127.0.0.1:$PORT/health" > /dev/null 2>&1; then
    notify-send "Friday" "Backend not running. Starting..."
    /home/sh4d0w/Projects/friday/start.sh --daemon &
    sleep 5
fi

# Open the chat UI in the default browser
xdg-open "http://127.0.0.1:$PORT" 2>/dev/null
