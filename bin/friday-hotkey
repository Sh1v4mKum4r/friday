#!/bin/bash
# friday-hotkey — Toggle Friday floating chat window
# Triggered by Super+F keybind

FRIDAY_DIR="$HOME/Projects/friday"

# Check if Friday window is already open — toggle it
FRIDAY_PID=$(pgrep -f "friday-window.py" 2>/dev/null | head -1)
if [ -n "$FRIDAY_PID" ]; then
    kill "$FRIDAY_PID" 2>/dev/null
    exit 0
fi

# Launch floating window
"$FRIDAY_DIR/.venv/bin/python" "$FRIDAY_DIR/bin/friday-window.py" &
