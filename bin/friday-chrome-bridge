#!/bin/bash
# friday-chrome-bridge — Manages headless Chrome for AI Mode API extension
#
# Usage:
#   friday-chrome-bridge setup      — Install extension + paste API URL (one-time)
#   friday-chrome-bridge start      — Start headless Chrome
#   friday-chrome-bridge stop       — Stop headless Chrome
#   friday-chrome-bridge reconnect  — Reopen visually to reconnect + paste new URL
#   friday-chrome-bridge status     — Check if running

CHROME_BIN="google-chrome-stable"
DISPLAY_NUM=99
PIDFILE="/tmp/friday-chrome-bridge.pid"
XVFB_PIDFILE="/tmp/friday-xvfb.pid"
CHROME_PROFILE="$HOME/.config/friday/chrome-bridge-profile"
CONFIG="$HOME/.config/friday/config.toml"

save_api_url() {
    echo ""
    echo "  Now copy the API ENDPOINT URL from the extension popup."
    echo ""
    echo -n "  Paste API URL: "
    read -r API_URL

    if [ -n "$API_URL" ]; then
        if grep -q "aimodeapi_url" "$CONFIG" 2>/dev/null; then
            sed -i "s|aimodeapi_url = \".*\"|aimodeapi_url = \"$API_URL\"|" "$CONFIG"
        else
            sed -i "/serpapi_key/a aimodeapi_url = \"$API_URL\"" "$CONFIG"
        fi
        echo ""
        echo -n "  Testing... "
        if curl -s "$API_URL" -H "Content-Type: application/json" -d '{"query":"test"}' 2>/dev/null | grep -q "success"; then
            echo "✓ Connected!"
        else
            echo "✗ Not responding (try again in a few seconds)"
        fi
        echo "  ✓ URL saved to config"
    else
        echo "  Skipped. Add later: friday config edit"
    fi
}

case "${1:-}" in
    setup)
        echo ""
        echo "  ┌─ AI Mode API Setup ─────────────────────┐"
        echo "  │                                          │"
        echo "  │  Chrome will open. Follow these steps:   │"
        echo "  │                                          │"
        echo "  │  1. Enable Developer mode (top-right)    │"
        echo "  │  2. Go to https://aimodeapi.com          │"
        echo "  │  3. Install the extension                │"
        echo "  │  4. Click extension icon in toolbar      │"
        echo "  │  5. Wait for green 'Connected'           │"
        echo "  │  6. Click 'Copy' next to API ENDPOINT    │"
        echo "  │  7. Come back here and paste it          │"
        echo "  │                                          │"
        echo "  └──────────────────────────────────────────┘"
        echo ""

        mkdir -p "$CHROME_PROFILE"

        # Enable developer mode
        PREFS_DIR="$CHROME_PROFILE/Default"
        mkdir -p "$PREFS_DIR"
        if [ -f "$PREFS_DIR/Preferences" ]; then
            python3 -c "
import json
with open('$PREFS_DIR/Preferences') as f: prefs = json.load(f)
prefs.setdefault('extensions', {})['ui'] = {'developer_mode': True}
with open('$PREFS_DIR/Preferences', 'w') as f: json.dump(prefs, f)
" 2>/dev/null
        else
            echo '{"extensions":{"ui":{"developer_mode":true}}}' > "$PREFS_DIR/Preferences"
        fi

        # Open Chrome (blocks until closed)
        $CHROME_BIN \
            --no-first-run \
            --user-data-dir="$CHROME_PROFILE" \
            "chrome://extensions" 2>/dev/null &
        CHROME_PID=$!

        # Ask for URL while Chrome is open
        save_api_url

        echo ""
        echo "  Close Chrome, then run: friday chrome-bridge start"
        wait $CHROME_PID 2>/dev/null
        ;;

    reconnect)
        echo "  Opening Chrome to reconnect..."
        echo "  Click the extension icon → wait for 'Connected'"
        echo ""

        # Stop headless if running
        if [ -f "$PIDFILE" ]; then
            kill "$(cat $PIDFILE)" 2>/dev/null
            rm -f "$PIDFILE"
        fi
        if [ -f "$XVFB_PIDFILE" ]; then
            kill "$(cat $XVFB_PIDFILE)" 2>/dev/null
            rm -f "$XVFB_PIDFILE"
        fi

        # Open visually
        $CHROME_BIN \
            --no-first-run \
            --user-data-dir="$CHROME_PROFILE" \
            "https://www.google.com" 2>/dev/null &
        CHROME_PID=$!

        # Ask for new URL if connection ID changed
        save_api_url

        echo ""
        echo "  Close Chrome. Restarting headless..."
        wait $CHROME_PID 2>/dev/null
        exec "$0" start
        ;;

    start)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
            echo "Already running (PID: $(cat $PIDFILE))"
            exit 0
        fi

        if [ ! -d "$CHROME_PROFILE/Default" ]; then
            echo "No profile found. Run 'friday chrome-bridge setup' first."
            exit 1
        fi

        Xvfb :$DISPLAY_NUM -screen 0 1280x720x24 >/dev/null 2>&1 &
        echo $! > "$XVFB_PIDFILE"
        sleep 1

        env \
            DISPLAY=:$DISPLAY_NUM \
            WAYLAND_DISPLAY="" \
            XDG_SESSION_TYPE=x11 \
            $CHROME_BIN \
            --no-first-run \
            --disable-sync \
            --disable-gpu \
            --disable-software-rasterizer \
            --user-data-dir="$CHROME_PROFILE" \
            --disable-features=WaylandWindowDecorations \
            --ozone-platform=x11 \
            --restore-last-session \
            "https://www.google.com" \
            >/dev/null 2>&1 &
        echo $! > "$PIDFILE"
        sleep 3

        echo "Chrome bridge running (headless, PID: $(cat $PIDFILE))"

        # Verify connection
        API_URL=$(grep "aimodeapi_url" "$CONFIG" 2>/dev/null | cut -d'"' -f2)
        if [ -n "$API_URL" ] && [ "$API_URL" != "" ]; then
            echo -n "Checking connection... "
            if curl -s "$API_URL" -H "Content-Type: application/json" -d '{"query":"test"}' 2>/dev/null | grep -q "success"; then
                echo "✓ Connected"
            else
                echo "✗ Extension not connected. Run: friday chrome-bridge reconnect"
            fi
        else
            echo "No API URL configured. Run: friday chrome-bridge reconnect"
        fi
        ;;

    stop)
        if [ -f "$PIDFILE" ]; then
            kill "$(cat $PIDFILE)" 2>/dev/null
            rm -f "$PIDFILE"
            echo "Chrome stopped."
        fi
        if [ -f "$XVFB_PIDFILE" ]; then
            kill "$(cat $XVFB_PIDFILE)" 2>/dev/null
            rm -f "$XVFB_PIDFILE"
            echo "Xvfb stopped."
        fi
        ;;

    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
            echo "Running (Chrome PID: $(cat $PIDFILE))"
            API_URL=$(grep "aimodeapi_url" "$CONFIG" 2>/dev/null | cut -d'"' -f2)
            [ -n "$API_URL" ] && echo "API URL: $API_URL"
        else
            echo "Not running."
        fi
        ;;

    *)
        echo "Usage: friday chrome-bridge <command>"
        echo ""
        echo "  setup      Install extension + paste API URL (one-time)"
        echo "  start      Start headless Chrome"
        echo "  stop       Stop headless Chrome"
        echo "  reconnect  Reopen Chrome to reconnect + update URL"
        echo "  status     Check if running"
        ;;
esac
