#!/bin/bash
# friday-chrome-bridge — Manages Chrome for AI Mode API extension
#
# The extension needs a real Chrome window (not headless).
# This script opens Chrome on a separate workspace so it's out of the way.

CHROME_BIN="google-chrome-stable"
CHROME_PROFILE="$HOME/.config/friday/chrome-bridge-profile"
CONFIG="$HOME/.config/friday/config.toml"
PIDFILE="/tmp/friday-chrome-bridge.pid"

save_api_url() {
    echo ""
    echo "  Copy the API ENDPOINT URL from the extension popup."
    echo ""
    echo -n "  Paste API URL: "
    read -r API_URL

    if [ -n "$API_URL" ]; then
        if grep -q "aimodeapi_url" "$CONFIG" 2>/dev/null; then
            sed -i "s|aimodeapi_url = \".*\"|aimodeapi_url = \"$API_URL\"|" "$CONFIG"
        else
            sed -i "/serpapi_key/a aimodeapi_url = \"$API_URL\"" "$CONFIG"
        fi
        echo ""
        echo -n "  Testing... "
        if curl -s "$API_URL" -H "Content-Type: application/json" -d '{"query":"test"}' 2>/dev/null | grep -q "success"; then
            echo "✓ Connected!"
        else
            echo "✗ Not responding (try again in a few seconds)"
        fi
        echo "  ✓ URL saved to config"
    else
        echo "  Skipped. Add later with: friday chrome-bridge reconnect"
    fi
}

case "${1:-}" in
    setup)
        echo ""
        echo "  ┌─ AI Mode API Setup ─────────────────────┐"
        echo "  │                                          │"
        echo "  │  Chrome will open. Follow these steps:   │"
        echo "  │                                          │"
        echo "  │  1. Enable Developer mode (top-right)    │"
        echo "  │  2. Go to https://aimodeapi.com          │"
        echo "  │  3. Install the extension                │"
        echo "  │  4. Click extension icon in toolbar      │"
        echo "  │  5. Wait for green 'Connected'           │"
        echo "  │  6. Click 'Copy' next to API ENDPOINT    │"
        echo "  │  7. Come back here and paste it          │"
        echo "  │                                          │"
        echo "  └──────────────────────────────────────────┘"
        echo ""

        mkdir -p "$CHROME_PROFILE/Default"

        # Enable developer mode
        if [ -f "$CHROME_PROFILE/Default/Preferences" ]; then
            python3 -c "
import json
with open('$CHROME_PROFILE/Default/Preferences') as f: prefs = json.load(f)
prefs.setdefault('extensions', {})['ui'] = {'developer_mode': True}
with open('$CHROME_PROFILE/Default/Preferences', 'w') as f: json.dump(prefs, f)
" 2>/dev/null
        else
            echo '{"extensions":{"ui":{"developer_mode":true}}}' > "$CHROME_PROFILE/Default/Preferences"
        fi

        $CHROME_BIN \
            --no-first-run \
            --user-data-dir="$CHROME_PROFILE" \
            "chrome://extensions" 2>/dev/null &

        save_api_url

        echo ""
        echo "  Done! Chrome will stay open to keep the connection alive."
        echo "  Move it to another workspace to hide it."
        echo ""
        echo "  To check: friday chrome-bridge status"
        echo "  To stop:  friday chrome-bridge stop"
        ;;

    start)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
            echo "Already running (PID: $(cat $PIDFILE))"
            exit 0
        fi

        if [ ! -d "$CHROME_PROFILE/Default" ]; then
            echo "No profile found. Run 'friday chrome-bridge setup' first."
            exit 1
        fi

        # Open Chrome minimized on current workspace
        $CHROME_BIN \
            --no-first-run \
            --disable-sync \
            --user-data-dir="$CHROME_PROFILE" \
            "https://www.google.com" \
            >/dev/null 2>&1 &
        echo $! > "$PIDFILE"

        sleep 3

        # Move to last workspace to hide it (Cosmic: Super+End, Hyprland: dispatch)
        if [ "$XDG_CURRENT_DESKTOP" = "COSMIC" ]; then
            # Move Chrome window to workspace 9 (out of the way)
            wtype -M logo -k 9 -m logo 2>/dev/null
        elif pgrep -x Hyprland >/dev/null 2>&1; then
            hyprctl dispatch movetoworkspacesilent 9 2>/dev/null
        fi

        echo "Chrome bridge running (PID: $(cat $PIDFILE))"
        echo "Moved to workspace 9 to stay out of the way."

        # Verify
        API_URL=$(grep "aimodeapi_url" "$CONFIG" 2>/dev/null | cut -d'"' -f2)
        if [ -n "$API_URL" ] && [ "$API_URL" != "" ]; then
            sleep 2
            echo -n "Checking... "
            if curl -s "$API_URL" -H "Content-Type: application/json" -d '{"query":"test"}' 2>/dev/null | grep -q "success"; then
                echo "✓ Connected"
            else
                echo "✗ Not connected. Run: friday chrome-bridge reconnect"
            fi
        fi
        ;;

    reconnect)
        echo "  Click the extension icon → wait for 'Connected'"
        echo ""

        # If not running, start Chrome first
        if [ ! -f "$PIDFILE" ] || ! kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
            $CHROME_BIN \
                --no-first-run \
                --user-data-dir="$CHROME_PROFILE" \
                "https://www.google.com" 2>/dev/null &
            echo $! > "$PIDFILE"
            sleep 3
        fi

        save_api_url
        ;;

    stop)
        if [ -f "$PIDFILE" ]; then
            kill "$(cat $PIDFILE)" 2>/dev/null
            rm -f "$PIDFILE"
            echo "Chrome stopped."
        else
            echo "Not running."
        fi
        ;;

    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
            echo "Running (PID: $(cat $PIDFILE))"
            API_URL=$(grep "aimodeapi_url" "$CONFIG" 2>/dev/null | cut -d'"' -f2)
            if [ -n "$API_URL" ]; then
                echo "API URL: $API_URL"
                echo -n "Connection: "
                if curl -s "$API_URL" -H "Content-Type: application/json" -d '{"query":"test"}' 2>/dev/null | grep -q "success"; then
                    echo "✓ Active"
                else
                    echo "✗ Disconnected"
                fi
            fi
        else
            echo "Not running."
        fi
        ;;

    *)
        echo "Usage: friday chrome-bridge <command>"
        echo ""
        echo "  setup      Install extension + paste API URL (one-time)"
        echo "  start      Open Chrome on workspace 9 (stays connected)"
        echo "  stop       Close Chrome"
        echo "  reconnect  Reconnect extension + update URL"
        echo "  status     Check connection"
        ;;
esac
