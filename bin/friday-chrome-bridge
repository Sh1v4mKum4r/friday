#!/bin/bash
# friday-chrome-bridge — Manages headless Chrome for AI Mode API extension
#
# Usage:
#   friday-chrome-bridge setup    — Open Chrome visually to install extension (one-time)
#   friday-chrome-bridge start    — Start headless Chrome with extension
#   friday-chrome-bridge stop     — Stop the background Chrome
#   friday-chrome-bridge status   — Check if running

CHROME_BIN="google-chrome-stable"
DISPLAY_NUM=99
PIDFILE="/tmp/friday-chrome-bridge.pid"
XVFB_PIDFILE="/tmp/friday-xvfb.pid"
CHROME_PROFILE="$HOME/.config/friday/chrome-bridge-profile"

case "${1:-}" in
    setup)
        echo "Opening Chrome with Friday bridge profile..."
        echo ""
        echo "Setup steps:"
        echo "  1. Enable 'Developer mode' in chrome://extensions (top-right toggle)"
        echo "  2. Go to https://aimodeapi.com and install the extension"
        echo "  3. Click the extension icon in toolbar to connect"
        echo "  4. Wait for green 'Connected' status"
        echo "  5. Copy the API ENDPOINT shown in the popup"
        echo "  6. Update your config:"
        echo "     friday config edit"
        echo "     # Add: aimodeapi_url = \"https://app.aimodeapi.com/api/YOUR-ID\""
        echo "  7. Close Chrome when done"
        echo ""
        echo "NOTE: The extension generates a unique API URL per connection."
        echo "      You need to update it in config if the connection ID changes."
        echo ""
        mkdir -p "$CHROME_PROFILE"

        # Enable developer mode in extensions preferences
        PREFS_DIR="$CHROME_PROFILE/Default"
        mkdir -p "$PREFS_DIR"
        if [ -f "$PREFS_DIR/Preferences" ]; then
            python3 -c "
import json
with open('$PREFS_DIR/Preferences') as f: prefs = json.load(f)
prefs.setdefault('extensions', {})['ui'] = {'developer_mode': True}
with open('$PREFS_DIR/Preferences', 'w') as f: json.dump(prefs, f)
" 2>/dev/null
        else
            echo '{"extensions":{"ui":{"developer_mode":true}}}' > "$PREFS_DIR/Preferences"
        fi

        $CHROME_BIN \
            --no-first-run \
            --user-data-dir="$CHROME_PROFILE" \
            "chrome://extensions" 2>/dev/null
        echo "Setup complete. Now run: friday-chrome-bridge start"
        ;;

    start)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
            echo "Already running (PID: $(cat $PIDFILE))"
            exit 0
        fi

        if [ ! -d "$CHROME_PROFILE/Default" ]; then
            echo "No profile found. Run 'friday-chrome-bridge setup' first."
            exit 1
        fi

        Xvfb :$DISPLAY_NUM -screen 0 1280x720x24 >/dev/null 2>&1 &
        echo $! > "$XVFB_PIDFILE"
        sleep 1

        env \
            DISPLAY=:$DISPLAY_NUM \
            WAYLAND_DISPLAY="" \
            XDG_SESSION_TYPE=x11 \
            $CHROME_BIN \
            --no-first-run \
            --disable-sync \
            --disable-gpu \
            --disable-software-rasterizer \
            --user-data-dir="$CHROME_PROFILE" \
            --disable-features=WaylandWindowDecorations \
            --ozone-platform=x11 \
            --restore-last-session \
            "https://www.google.com" \
            >/dev/null 2>&1 &
        echo $! > "$PIDFILE"

        echo "Chrome bridge running (headless, PID: $(cat $PIDFILE))"
        ;;

    stop)
        if [ -f "$PIDFILE" ]; then
            kill "$(cat $PIDFILE)" 2>/dev/null
            rm -f "$PIDFILE"
            echo "Chrome stopped."
        fi
        if [ -f "$XVFB_PIDFILE" ]; then
            kill "$(cat $XVFB_PIDFILE)" 2>/dev/null
            rm -f "$XVFB_PIDFILE"
            echo "Xvfb stopped."
        fi
        ;;

    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
            echo "Running (Chrome PID: $(cat $PIDFILE))"
        else
            echo "Not running."
        fi
        ;;

    *)
        echo "Usage: friday-chrome-bridge <command>"
        echo ""
        echo "  setup    Open Chrome to install AI Mode API extension (one-time)"
        echo "  start    Start headless Chrome (no visible window)"
        echo "  stop     Stop headless Chrome"
        echo "  status   Check if running"
        ;;
esac
