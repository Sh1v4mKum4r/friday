#!/usr/bin/env bash
# friday — main entry point for Friday AI assistant
set -euo pipefail

FRIDAY_DIR="$(dirname "$(dirname "$(readlink -f "$0")")")"
VERSION="0.1.0"

show_help() {
    cat << 'EOF'
   ___       _     _            v0.1.0
  | __| _ _ (_) __| | __ _  _  _
  | _| | '_|| |/ _` |/ _` || || |
  |_|  |_|  |_|\__,_|\__,_| \_, |
                             |__/

 LAUNCH
  start                Start Friday (backend + CLI)
  start --daemon       Daemon mode (background)
  stop                 Stop everything
  tui                  Terminal UI
  gui                  Floating chat window
  send <prompt>        One-shot prompt (stateless)

 MANAGE
  tools                List built-in tools
  mcp                  List MCP servers          [enable/disable/info/restart]
  models               Ollama models             [pull/rm]
  memory               Saved memories            [forget/clear]
  history              Past conversations        [load/clear]
  mode                 Provider mode             [fallback/race/google]
  config               Show config               [edit]

 MAINTAIN
  status               What's running
  health               Provider check
  doctor               Full diagnostic
  backup               Backup config + data
  restore              Restore from backup
  reset                Reset to defaults
  update               Git pull + rebuild
  logs                 Tail backend logs
  completions          Shell tab-completion

 QUICK (Super+F = floating window)
  friday-tui            friday-send <prompt>            friday-gui

EOF
}

# Activate venv
if [ -f "$FRIDAY_DIR/.venv/bin/activate" ]; then
    source "$FRIDAY_DIR/.venv/bin/activate"
fi

PORT=65535
API="http://127.0.0.1:$PORT"
DATA_DIR="$HOME/.local/share/friday"
CONFIG_DIR="$HOME/.config/friday"
BACKUP_DIR="$HOME/.local/share/friday/backups"

# -----------------------------------------------------------------------
# Helper: indexed selector
# -----------------------------------------------------------------------
# Prints items with [N] index, returns selected item for given input
select_by_index() {
    local -n items_ref=$1
    local selection=$2
    # If it's a number, use as index
    if [[ "$selection" =~ ^[0-9]+$ ]]; then
        local idx=$((selection - 1))
        if [ $idx -ge 0 ] && [ $idx -lt ${#items_ref[@]} ]; then
            echo "${items_ref[$idx]}"
            return 0
        fi
    fi
    # Otherwise return as-is (name match)
    echo "$selection"
}

case "${1:-}" in
    # -------------------------------------------------------------------
    start)
        shift
        exec "$FRIDAY_DIR/start.sh" "$@"
        ;;

    # -------------------------------------------------------------------
    stop)
        echo "Stopping Friday..."
        kill $(lsof -ti:$PORT) 2>/dev/null && echo "  Backend stopped." || echo "  Backend not running."
        pkill -f "friday_core.*--daemon" 2>/dev/null && echo "  Daemon stopped." || echo "  Daemon not running."
        rm -f "${XDG_RUNTIME_DIR:-/tmp}/friday.sock"
        echo "Done."
        ;;

    # -------------------------------------------------------------------
    status)
        echo "┌─ Friday Status ─────────────────────────┐"
        echo -n "│ Backend:       "
        if curl -s "$API/health" > /dev/null 2>&1; then
            echo "ONLINE                    │"
            PROVIDERS=$(curl -s "$API/health" | python3 -c "import sys,json; print(', '.join(json.load(sys.stdin)['providers']))" 2>/dev/null)
            printf "│ Providers:     %-26s│\n" "$PROVIDERS"
        else
            echo "OFFLINE                   │"
        fi
        echo -n "│ Daemon socket: "
        [ -S "${XDG_RUNTIME_DIR:-/tmp}/friday.sock" ] && echo "ACTIVE                    │" || echo "INACTIVE                  │"
        echo -n "│ Ollama:        "
        if curl -s http://localhost:11434/api/tags > /dev/null 2>&1; then
            MODELS=$(curl -s http://localhost:11434/api/tags | python3 -c "import sys,json; ms=json.load(sys.stdin)['models']; print(', '.join(m['name'] for m in ms))" 2>/dev/null)
            printf "%-26s│\n" "RUNNING ($MODELS)"
        else
            echo "NOT RUNNING               │"
        fi
        echo "└──────────────────────────────────────────┘"
        ;;

    # -------------------------------------------------------------------
    tui)
        shift
        exec python -m friday_ai.tui "$@"
        ;;

    gui)
        exec "$FRIDAY_DIR/bin/friday-hotkey"
        ;;

    send)
        shift
        "$FRIDAY_DIR/bin/friday-send" "$@"
        exit $?
        ;;

    # -------------------------------------------------------------------
    mode)
        shift
        CURRENT=$(grep "provider_mode" "$CONFIG_DIR/config.toml" | cut -d'"' -f2)
        case "${1:-}" in
            fallback)
                sed -i 's/provider_mode = ".*"/provider_mode = "fallback"/' "$CONFIG_DIR/config.toml"
                echo "Mode: fallback (Ollama → cloud CLI if fails)"
                echo "Restart Friday to apply."
                ;;
            race)
                sed -i 's/provider_mode = ".*"/provider_mode = "race"/' "$CONFIG_DIR/config.toml"
                echo "Mode: race (cloud providers race, fastest wins)"
                echo "Restart Friday to apply."
                ;;
            google)
                sed -i 's/provider_mode = ".*"/provider_mode = "google"/' "$CONFIG_DIR/config.toml"
                echo "Mode: google (all queries via Google AI API)"
                echo "Restart Friday to apply."
                ;;
            *)
                echo "Current mode: $CURRENT"
                echo ""
                echo "Available modes:"
                echo "  fallback  — Ollama first, cloud if fails (local-first, offline-capable)"
                echo "  race      — Cloud providers race, fastest wins (needs internet)"
                echo "  google    — Opens Google AI mode in browser for the query"
                echo ""
                echo "Use: friday mode fallback"
                echo "     friday mode race"
                echo "     friday mode google"
                ;;
        esac
        ;;

    # -------------------------------------------------------------------
    tools)
        shift
        echo "Built-in tools:"
        if curl -s "$API/health" > /dev/null 2>&1; then
            curl -s -X POST "$API/reload" | python3 -c "
import sys,json
d = json.load(sys.stdin)
tools = d['tools']
names = sorted(t if isinstance(t, str) else t.get('name', str(t)) for t in tools)
for i, t in enumerate(names, 1):
    print(f'  [{i:2}] {t}')
print(f'\n  Total: {len(names)} tools')
"
        else
            echo "  (backend offline — start with: friday start)"
        fi
        echo ""
        echo "  See also: friday mcp"
        ;;

    # -------------------------------------------------------------------
    mcp)
        shift
        case "${1:-}" in
            enable)
                shift
                python3 -c "
import json, sys
with open('$CONFIG_DIR/mcp_servers.json') as f: data = json.load(f)
names = list(data['servers'].keys())
sel = '$*'
if sel.isdigit():
    idx = int(sel) - 1
    if 0 <= idx < len(names): sel = names[idx]
    else: print(f'Invalid index: {int(sel)}'); sys.exit(1)
if sel and not sel.startswith('friday-'): sel = 'friday-' + sel
if sel in data['servers']:
    data['servers'][sel]['enabled'] = True
    with open('$CONFIG_DIR/mcp_servers.json', 'w') as f: json.dump(data, f, indent=2)
    print(f'Enabled: {sel}')
else:
    print(f'Not found: {sel}')
    for i, n in enumerate(names, 1): print(f'  [{i}] {n}')
"
                ;;
            disable)
                shift
                python3 -c "
import json, sys
with open('$CONFIG_DIR/mcp_servers.json') as f: data = json.load(f)
names = list(data['servers'].keys())
sel = '$*'
if sel.isdigit():
    idx = int(sel) - 1
    if 0 <= idx < len(names): sel = names[idx]
    else: print(f'Invalid index: {int(sel)}'); sys.exit(1)
if sel and not sel.startswith('friday-'): sel = 'friday-' + sel
if sel in data['servers']:
    data['servers'][sel]['enabled'] = False
    with open('$CONFIG_DIR/mcp_servers.json', 'w') as f: json.dump(data, f, indent=2)
    print(f'Disabled: {sel}')
else:
    print(f'Not found: {sel}')
"
                ;;
            info)
                shift
                python3 -c "
import json, sys, importlib.util
with open('$CONFIG_DIR/mcp_servers.json') as f: data = json.load(f)
names = list(data['servers'].keys())
sel = '$*'
if sel.isdigit():
    idx = int(sel) - 1
    if 0 <= idx < len(names): sel = names[idx]
    else: print(f'Invalid index: {int(sel)}'); sys.exit(1)
if sel and not sel.startswith('friday-'): sel = 'friday-' + sel
if sel not in data['servers']:
    print(f'Not found: {sel}'); sys.exit(1)
cfg = data['servers'][sel]
status = '\033[32mENABLED\033[0m' if cfg['enabled'] else '\033[31mDISABLED\033[0m'
print(f'Server: {sel}')
print(f'Status: {status}')
print(f'Command: {cfg[\"command\"]} {\" \".join(cfg[\"args\"])}')
# Extract tool names from source file
try:
    script = cfg['args'][-1]
    import re
    source = open(script).read()
    # Find Tool(name='...' or name='...' patterns
    tools = re.findall(r'name[=:]\s*[\"\\']([a-z_]+)[\"\\']', source)
    # Deduplicate and filter (skip 'friday-*' server names)
    seen = set()
    tool_list = []
    for t in tools:
        if t not in seen and not t.startswith('friday') and len(t) > 2:
            seen.add(t)
            tool_list.append(t)
    if tool_list:
        print(f'Tools ({len(tool_list)}):')
        for i, t in enumerate(tool_list, 1):
            print(f'  [{i}] {t}')
    else:
        print('Tools: (none found)')
except Exception as e:
    print(f'Could not read tools: {e}')
"
                ;;
            restart|reconnect)
                if curl -s "$API/health" > /dev/null 2>&1; then
                    echo "Reconnecting MCP servers..."
                    curl -s -X POST "$API/mcp/reconnect" | python3 -c "
import sys,json
d = json.load(sys.stdin)
connected = d.get('connected', [])
if connected:
    for s in connected: print(f'  Connected: {s}')
else:
    print('  No servers connected.')
"
                else
                    echo "Backend offline."
                fi
                ;;
            *)
                echo "MCP Servers:"
                python3 -c "
import json
with open('$CONFIG_DIR/mcp_servers.json') as f: data = json.load(f)
on = 0; off = 0
for i, (name, cfg) in enumerate(data['servers'].items(), 1):
    enabled = cfg['enabled']
    status = '\033[32mON \033[0m' if enabled else '\033[31mOFF\033[0m'
    short = name.replace('friday-', '')
    print(f'  [{i:2}] {status} {short}')
    if enabled: on += 1
    else: off += 1
print(f'\n  {on} enabled, {off} disabled')
print(f'  Use: friday mcp enable <number>')
print(f'  Use: friday mcp info <number>')
print(f'  Use: friday mcp restart')
"
                ;;
        esac
        ;;

    # -------------------------------------------------------------------
    models)
        shift
        case "${1:-}" in
            pull)
                shift
                echo "Pulling model: $*"
                ollama pull "$@"
                ;;
            rm|remove)
                shift
                SELECTION="$*"
                python3 -c "
import json, subprocess, sys
result = subprocess.run(['curl', '-s', 'http://localhost:11434/api/tags'], capture_output=True, text=True)
data = json.loads(result.stdout)
models = [m['name'] for m in data.get('models', [])]
sel = '$SELECTION'
if sel.isdigit():
    idx = int(sel) - 1
    if 0 <= idx < len(models): sel = models[idx]
    else: print(f'Invalid index: {int(sel)}'); sys.exit(1)
if sel in models:
    subprocess.run(['ollama', 'rm', sel])
    print(f'Removed: {sel}')
else:
    print(f'Not found: {sel}')
    for i, m in enumerate(models, 1): print(f'  [{i}] {m}')
"
                ;;
            *)
                echo "Ollama models:"
                python3 -c "
import json, subprocess
result = subprocess.run(['curl', '-s', 'http://localhost:11434/api/tags'], capture_output=True, text=True)
data = json.loads(result.stdout)
models = data.get('models', [])
if not models:
    print('  (none installed)')
else:
    for i, m in enumerate(models, 1):
        size_gb = m.get('size', 0) / (1024**3)
        print(f'  [{i}] {m[\"name\"]:20} {size_gb:.1f} GB')
print(f'\n  Use: friday models pull <name>')
print('  Use: friday models rm <number>')
" 2>/dev/null || echo "  Ollama not running."
                ;;
        esac
        ;;

    # -------------------------------------------------------------------
    memory)
        shift
        case "${1:-}" in
            forget)
                shift
                SELECTION="$*"
                if [[ "$SELECTION" =~ ^[0-9]+$ ]]; then
                    # Forget by index
                    python3 -c "
lines = open('$DATA_DIR/memory/MEMORY.md').read().strip().splitlines()
entries = [l.lstrip('- ').strip() for l in lines if l.strip().startswith('-')]
idx = int('$SELECTION') - 1
if 0 <= idx < len(entries):
    keyword = entries[idx]
    remaining = [l for l in lines if keyword not in l]
    open('$DATA_DIR/memory/MEMORY.md', 'w').write('\n'.join(remaining) + '\n' if remaining else '')
    print(f'Forgot: {keyword}')
else:
    print(f'Invalid index: $SELECTION')
"
                else
                    if curl -s "$API/health" > /dev/null 2>&1; then
                        curl -s -X POST "$API/memory/forget?keyword=$SELECTION" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'Forgot: {d[\"forgot\"]}')"
                    else
                        python3 -c "
lines = open('$DATA_DIR/memory/MEMORY.md').read().strip().splitlines()
remaining = [l for l in lines if '$SELECTION'.lower() not in l.lower()]
open('$DATA_DIR/memory/MEMORY.md', 'w').write('\n'.join(remaining) + '\n' if remaining else '')
print('Forgot entries matching: $SELECTION')
"
                    fi
                fi
                ;;
            clear)
                echo -n "" > "$DATA_DIR/memory/MEMORY.md"
                echo "Memory cleared."
                ;;
            *)
                echo "Memories:"
                python3 -c "
lines = open('$DATA_DIR/memory/MEMORY.md').read().strip().splitlines()
entries = [l.lstrip('- ').strip() for l in lines if l.strip().startswith('-')]
if entries:
    for i, e in enumerate(entries, 1):
        print(f'  [{i}] {e}')
else:
    print('  (empty)')
print(f'\n  Use: friday memory forget <number>')
"
                ;;
        esac
        ;;

    # -------------------------------------------------------------------
    history)
        shift
        case "${1:-}" in
            load)
                shift
                SELECTION="$*"
                python3 -c "
import json, os
from pathlib import Path
hist_dir = Path('$DATA_DIR/history')
sessions = sorted(hist_dir.glob('session-*.json'), reverse=True)
sel = '$SELECTION'
if sel.isdigit():
    idx = int(sel) - 1
    if 0 <= idx < len(sessions):
        data = json.loads(sessions[idx].read_text())
        msgs = data.get('messages', [])
        for m in msgs[-10:]:
            role = m.get('role', '?')
            text = m.get('content', '')[:100]
            print(f'  [{role}] {text}')
        print(f'\n  ({len(msgs)} messages total)')
    else:
        print(f'Invalid index: {sel}')
else:
    print('Usage: friday history load <number>')
"
                ;;
            clear)
                rm -f "$DATA_DIR/history/session-*.json"
                echo "History cleared."
                ;;
            *)
                echo "Conversation history:"
                python3 -c "
import json
from pathlib import Path
from datetime import datetime
hist_dir = Path('$DATA_DIR/history')
sessions = sorted(hist_dir.glob('session-*.json'), reverse=True)
if not sessions:
    print('  (no saved conversations)')
else:
    for i, s in enumerate(sessions[:20], 1):
        data = json.loads(s.read_text())
        msgs = data.get('messages', [])
        ts = data.get('timestamp', s.stem.replace('session-', ''))
        first_msg = ''
        for m in msgs:
            if m.get('role') == 'user':
                first_msg = m.get('content', '')[:40]
                break
        print(f'  [{i:2}] {ts}  {first_msg:40} ({len(msgs)} msgs)')
print(f'\n  Use: friday history load <number>')
"
                ;;
        esac
        ;;

    # -------------------------------------------------------------------
    config)
        shift
        case "${1:-}" in
            edit)
                ${EDITOR:-nvim} "$CONFIG_DIR/config.toml"
                ;;
            *)
                cat "$CONFIG_DIR/config.toml"
                ;;
        esac
        ;;

    # -------------------------------------------------------------------
    health)
        curl -s "$API/health" 2>/dev/null | python3 -m json.tool 2>/dev/null || echo "Backend offline."
        ;;

    # -------------------------------------------------------------------
    doctor)
        set +e  # Disable strict mode for doctor
        echo "┌─ Friday Doctor ──────────────────────────┐"
        echo "│ Checking dependencies...                  │"
        echo "└───────────────────────────────────────────┘"
        echo ""
        PASS=0; FAIL=0; WARN=0

        check() {
            local name="$1" cmd="$2"
            if eval "$cmd" > /dev/null 2>&1; then
                echo -e "  \033[32m✓\033[0m $name"
                PASS=$((PASS + 1))
            else
                echo -e "  \033[31m✗\033[0m $name"
                FAIL=$((FAIL + 1))
            fi
        }

        warn() {
            local name="$1" cmd="$2"
            if eval "$cmd" > /dev/null 2>&1; then
                echo -e "  \033[32m✓\033[0m $name"
                PASS=$((PASS + 1))
            else
                echo -e "  \033[33m⚠\033[0m $name (optional)"
                WARN=$((WARN + 1))
            fi
        }

        echo "Core:"
        check "Python 3.11+"          "python3 -c 'import sys; assert sys.version_info >= (3,11)'"
        check "Friday venv"            "test -f $FRIDAY_DIR/.venv/bin/python"
        check "FastAPI"                "python3 -c 'import fastapi'"
        check "Ollama"                 "which ollama"
        check "Ollama running"         "curl -s http://localhost:11434/api/tags"
        check "Ollama has models"      "curl -s http://localhost:11434/api/tags | python3 -c 'import sys,json; assert json.load(sys.stdin)[\"models\"]'"
        check "Rust toolchain"         "which cargo"
        check "Friday Rust binary"     "test -f $FRIDAY_DIR/friday_core/target/release/friday_core"
        check "Config exists"          "test -f $CONFIG_DIR/config.toml"
        check "SOUL.md exists"         "test -f $CONFIG_DIR/SOUL.md"

        echo ""
        echo "Tools:"
        check "wtype (keyboard)"       "which wtype"
        check "ydotool (mouse)"        "which ydotool"
        warn  "ydotoold running"       "pgrep ydotoold"
        check "grim (screenshot)"      "which grim"
        check "slurp (region select)"  "which slurp"
        check "tesseract (OCR)"        "which tesseract"
        check "notify-send"            "which notify-send"
        check "brightnessctl"          "which brightnessctl"
        check "playerctl"              "which playerctl"
        warn  "socat"                  "which socat"
        warn  "googler (web search)"   "which googler"
        warn  "wlrctl (window list)"   "which wlrctl"

        echo ""
        echo "Paths:"
        check "friday in PATH"         "which friday"
        check "friday-tui in PATH"     "which friday-tui"
        check "friday-send in PATH"    "which friday-send"
        check "friday-gui in PATH"     "which friday-gui"

        echo ""
        echo "Network:"
        check "Backend reachable"      "curl -s $API/health"
        warn  "Internet available"     "ping -c1 -W2 1.1.1.1"
        warn  "Daemon socket"          "test -S ${XDG_RUNTIME_DIR:-/tmp}/friday.sock"

        echo ""
        echo "────────────────────────────────────────────"
        echo -e "  \033[32m$PASS passed\033[0m  \033[31m$FAIL failed\033[0m  \033[33m$WARN optional missing\033[0m"
        [ $FAIL -gt 0 ] && echo "  Run missing installs to fix failures."
        ;;

    # -------------------------------------------------------------------
    models)
        # Already handled above, this is a fallback
        echo "Use: friday models"
        ;;

    # -------------------------------------------------------------------
    backup)
        mkdir -p "$BACKUP_DIR"
        TIMESTAMP=$(date +%Y%m%d_%H%M%S)
        BACKUP_FILE="$BACKUP_DIR/friday-backup-$TIMESTAMP.tar.gz"
        echo "Creating backup..."
        tar czf "$BACKUP_FILE" \
            -C "$HOME" \
            .config/friday/config.toml \
            .config/friday/SOUL.md \
            .config/friday/USER.md \
            .config/friday/AGENTS.md \
            .config/friday/mcp_servers.json \
            .local/share/friday/memory/ \
            .local/share/friday/history/ \
            2>/dev/null
        SIZE=$(du -h "$BACKUP_FILE" | cut -f1)
        echo "Backup saved: $BACKUP_FILE ($SIZE)"
        ;;

    restore)
        shift
        FILE="${1:-}"
        if [ -z "$FILE" ]; then
            echo "Available backups:"
            ls -1t "$BACKUP_DIR"/friday-backup-*.tar.gz 2>/dev/null | head -10 | nl -ba
            echo ""
            echo "Usage: friday restore <file>"
            exit 0
        fi
        if [ ! -f "$FILE" ]; then
            # Try as index
            if [[ "$FILE" =~ ^[0-9]+$ ]]; then
                BACKUPS=($(ls -1t "$BACKUP_DIR"/friday-backup-*.tar.gz 2>/dev/null))
                IDX=$(($FILE - 1))
                if [ $IDX -ge 0 ] && [ $IDX -lt ${#BACKUPS[@]} ]; then
                    FILE="${BACKUPS[$IDX]}"
                else
                    echo "Invalid index."
                    exit 1
                fi
            else
                echo "File not found: $FILE"
                exit 1
            fi
        fi
        echo "Restoring from: $FILE"
        tar xzf "$FILE" -C "$HOME"
        echo "Restored config, memory, and history."
        ;;

    # -------------------------------------------------------------------
    reset)
        echo "This will reset Friday to defaults. Your memory and history will be kept."
        echo -n "Continue? [y/N] "
        read -r REPLY
        if [[ "$REPLY" =~ ^[Yy]$ ]]; then
            cp "$FRIDAY_DIR/config/config.toml" "$CONFIG_DIR/config.toml"
            cp "$FRIDAY_DIR/config/SOUL.md" "$CONFIG_DIR/SOUL.md"
            cp "$FRIDAY_DIR/config/USER.md" "$CONFIG_DIR/USER.md"
            cp "$FRIDAY_DIR/config/AGENTS.md" "$CONFIG_DIR/AGENTS.md"
            echo "Config reset to defaults. Memory and history preserved."
        else
            echo "Cancelled."
        fi
        ;;

    # -------------------------------------------------------------------
    update)
        echo "Updating Friday..."
        cd "$FRIDAY_DIR"
        echo "  Pulling latest..."
        git pull 2>&1 | sed 's/^/  /'
        echo "  Updating Python deps..."
        .venv/bin/pip install -e ".[dev]" -q 2>&1 | tail -1 | sed 's/^/  /'
        echo "  Rebuilding Rust core..."
        cd friday_core && cargo build --release 2>&1 | tail -1 | sed 's/^/  /'
        cd ..
        echo "  Done. Restart Friday to apply changes."
        ;;

    # -------------------------------------------------------------------
    logs)
        tail -f "$DATA_DIR/uvicorn.log" 2>/dev/null || echo "No log file found."
        ;;

    # -------------------------------------------------------------------
    completions)
        cat << 'COMP'
# Add to ~/.zshrc or ~/.bashrc:
# eval "$(friday completions)"

_friday_completions() {
    local commands="start stop status tui gui send tools mcp models memory history config health doctor backup restore reset update logs completions version help mode"
    local mcp_sub="enable disable info restart"
    local tools_sub="enable disable"
    local models_sub="pull rm"
    local memory_sub="forget clear"
    local history_sub="load clear"
    local config_sub="edit"

    if [ "${#COMP_WORDS[@]}" -eq 2 ]; then
        COMPREPLY=($(compgen -W "$commands" -- "${COMP_WORDS[1]}"))
    elif [ "${#COMP_WORDS[@]}" -eq 3 ]; then
        case "${COMP_WORDS[1]}" in
            tools) COMPREPLY=($(compgen -W "$tools_sub" -- "${COMP_WORDS[2]}")) ;;
            mcp) COMPREPLY=($(compgen -W "$mcp_sub" -- "${COMP_WORDS[2]}")) ;;
            mode) COMPREPLY=($(compgen -W "fallback race google" -- "${COMP_WORDS[2]}")) ;;
            models) COMPREPLY=($(compgen -W "$models_sub" -- "${COMP_WORDS[2]}")) ;;
            memory) COMPREPLY=($(compgen -W "$memory_sub" -- "${COMP_WORDS[2]}")) ;;
            history) COMPREPLY=($(compgen -W "$history_sub" -- "${COMP_WORDS[2]}")) ;;
            config) COMPREPLY=($(compgen -W "$config_sub" -- "${COMP_WORDS[2]}")) ;;
            start) COMPREPLY=($(compgen -W "--daemon" -- "${COMP_WORDS[2]}")) ;;
        esac
    fi
}
complete -F _friday_completions friday
COMP
        ;;

    # -------------------------------------------------------------------
    version)
        echo "Friday v$VERSION"
        ;;

    help|--help|-h)
        show_help
        ;;

    "")
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        echo "Run 'friday help' for all commands."
        exit 1
        ;;
esac
